[Unit]
Description=Starlink Monitor - Healthcheck (перевірка /healthz, примусовий restart при зависанні)
After=starlink-monitor.service starlink-webui.service

[Service]
Type=oneshot
# Змінні з env-файлу тут не підвантажуємо: його пише RUN_USER (веб-інтерфейс), а юніт - root, тож
# BASH_ENV/LD_PRELOAD з нього дали б root. Порт скрипт читає сам.
ExecStart=/opt/starlink-monitor/scripts/watchdog_healthcheck.sh
StandardOutput=journal
StandardError=journal
# Таймер запускає юніт тисячі разів на добу, а systemd пише 3 рядки (Starting/Deactivated/Finished,
# info) на КОЖЕН запуск — ~13 000 рядків/добу на SD від двох таймерів. LogLevelMax=notice їх
# відсікає (systemd >= 248 застосовує фільтр і до повідомлень PID 1), а SyslogLevel=notice піднімає
# вивід самого скрипта до notice, щоб корисні рядки ("==> ...") і помилки лишились.
LogLevelMax=notice
SyslogLevel=notice

# Потребує root для systemctl restart іншого сервіса. Звужено до
# мінімуму - лише читання мережі (curl локально) й керування
# systemd-юнітами, нічого більше.
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true

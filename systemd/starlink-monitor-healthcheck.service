[Unit]
Description=Starlink Monitor - Healthcheck (перевірка /healthz, примусовий restart при зависанні)
After=starlink-monitor.service starlink-webui.service

[Service]
Type=oneshot
EnvironmentFile=-/etc/starlink-monitor/env
ExecStart=/opt/starlink-monitor/scripts/watchdog_healthcheck.sh
StandardOutput=journal
StandardError=journal
# Таймер запускає юніт тисячі разів на добу; systemd пише 3 рядки
# (Starting/Deactivated/Finished, рівень info) на КОЖЕН запуск - ~13 000
# рядків/добу на SD-картку від двох таймерів. LogLevelMax=notice відсікає
# їх (systemd >= 248 застосовує фільтр і до повідомлень PID 1 про юніт),
# а SyslogLevel=notice піднімає власний вивід скрипта до notice, щоб
# корисні рядки ("==> ...") і помилки не відсіклись разом із шумом.
LogLevelMax=notice
SyslogLevel=notice

# Потребує root для systemctl restart іншого сервіса. Звужено до
# мінімуму - лише читання мережі (curl локально) й керування
# systemd-юнітами, нічого більше.
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true

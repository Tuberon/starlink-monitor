[Unit]
Description=Starlink Monitor - WAN failover (перевірка інтернету через wlan0, переключення на eth0)
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
ExecStart=/opt/starlink-monitor/scripts/wan_failover_check.sh
StandardOutput=journal
StandardError=journal
# Таймер запускає юніт тисячі разів на добу, а systemd пише 3 рядки (Starting/Deactivated/Finished,
# info) на КОЖЕН запуск — ~13 000 рядків/добу на SD від двох таймерів. LogLevelMax=notice їх
# відсікає (systemd >= 248 застосовує фільтр і до повідомлень PID 1), а SyslogLevel=notice піднімає
# вивід самого скрипта до notice, щоб корисні рядки ("==> ...") і помилки лишились.
LogLevelMax=notice
SyslogLevel=notice

# Потребує root для зміни таблиці маршрутизації (ip route) — єдиний сервіс проєкту від root (решта —
# RUN_USER із вузькими sudo-правилами), тому можливості звужено до потрібних: CAP_NET_ADMIN (ip
# route) і CAP_NET_RAW (ping).
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
# RuntimeDirectoryPreserve=yes - без цього systemd видаляє директорію
# одразу після кожного завершення oneshot-сервісу, а timer запускає
# цей сервіс заново кожні ~30с - файл стану (потрібен для гістерезису
# між запусками) був би втрачений щоразу без цього прапорця.
RuntimeDirectory=starlink-wan-failover
RuntimeDirectoryPreserve=yes
CapabilityBoundingSet=CAP_NET_ADMIN CAP_NET_RAW
AmbientCapabilities=CAP_NET_ADMIN CAP_NET_RAW
